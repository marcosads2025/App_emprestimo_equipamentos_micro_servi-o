{
  "info": {
    "name": "msemprestimo - Empréstimo de Equipamentos",
    "description": "Rode as pastas 'Preparação' e 'Cenários' em ordem (Run collection). Requer discovery-server, api-gateway, msusuario, msequipamento e msemprestimo no ar. A pasta 'Manual' testa erros de comunicação: rode cada requisição sozinha após desligar o serviço indicado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Preparação",
      "item": [
        {
          "name": "S1 - Criar usuário (msusuario)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "usuarios"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Ana Souza\",\n  \"email\": \"ana.{{sufixo}}@escola.edu.br\",\n  \"matricula\": \"MAT-{{sufixo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sufixo único: permite rodar a collection várias vezes sem violar unicidade",
                  "pm.collectionVariables.set('sufixo', Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('usuarioId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "S2 - Criar equipamento (msequipamento)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/equipamentos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "equipamentos"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Notebook Dell Latitude\",\n  \"tipo\": \"NOTEBOOK\",\n  \"patrimonio\": \"PAT-{{sufixo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('equipamentoId', pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cenários",
      "item": [
        {
          "name": "01 - Solicitar empréstimo (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/emprestimos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "emprestimos"
              ]
            },
            "description": "Fluxo do item 7: valida usuário, consulta e reserva o equipamento, grava ATIVO.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": \"{{usuarioId}}\",\n  \"equipamentoId\": \"{{equipamentoId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('Status ATIVO', () => pm.expect(b.status).to.eql('ATIVO'));",
                  "pm.test('Retorna o ID', () => pm.expect(b.id).to.be.a('string'));",
                  "pm.test('Header Location', () => pm.response.to.have.header('Location'));",
                  "pm.collectionVariables.set('emprestimoId', b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Equipamento reservado com o ID do empréstimo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/equipamentos/{{equipamentoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "equipamentos",
                "{{equipamentoId}}"
              ]
            },
            "description": "Confere no msequipamento que a reserva usou o mesmo ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Indisponível', () => pm.expect(b.disponivel).to.eql(false));",
                  "pm.test('Reserva = emprestimoId', () => pm.expect(b.emprestimoReservaId).to.eql(pm.collectionVariables.get('emprestimoId')));"
                ]
              }
            }
          ]
        },
